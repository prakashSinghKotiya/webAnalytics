# ==============================================================================
# Speed Backend - Environment Variables
# ==============================================================================

# Application Port
PORT=5000

# Client & Socket Allowed Origins (comma-separated for multiple origins)
CLIENT_ORIGIN="http://localhost:5173,http://localhost:3000"
SOCKET_ORIGIN="http://localhost:5173"

# Cookie Security Secret
COOKIE_SECRET="your-cookie-secret-min-32-chars"

# ==============================================================================
# Database & Job Queue (PostgreSQL + pg-boss)
# ==============================================================================
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://user:password@localhost:5432/speed_db?schema=public"

# Optional: Direct PostgreSQL connection string for pg-boss
# Note: pg-boss requires a direct PostgreSQL connection (not PgBouncer transaction mode).
# If omitted, pg-boss defaults to DATABASE_URL.
# PGBOSS_DATABASE_URL="postgresql://user:password@localhost:5432/speed_db?schema=public"
# PGBOSS_POOL_MAX=20
# PGBOSS_APP_NAME="speed-pgboss"

# Worker Concurrency Settings (Optional)
# TTFB_WORKER_CONCURRENCY=10
# LIGHTHOUSE_WORKER_CONCURRENCY=4
# UPTIME_WORKER_CONCURRENCY=10
# DNS_WORKER_CONCURRENCY=10
# REDIRECT_WORKER_CONCURRENCY=10
# WHOIS_WORKER_CONCURRENCY=10

# Uptime Monitoring & Batch Runners Settings
# UPTIME_BATCH_SIZE=50 # Number of monitors per pg-boss batch job (default 50)
# UPTIME_WORKER_CONCURRENCY=2 # Concurrency of batch worker (default 2)
# UPTIME_ALERT_COOLDOWN_MS=1800000 # 30 minutes cooldown between repeated DOWN alerts
# UPTIME_ALERT_THROTTLE=true # Set to "false" to disable cooldown and alert on every check
# RUNNER_FALLBACK_LOCAL=true # Fallback to local runner if Lambda/HTTP runner fails (default true)
# AWS_UPTIME_KEY_ID="" # AWS IAM access key ID for Lambda runner
# AWS_UPTIME_SECRET="" # AWS IAM secret access key for Lambda runner
# RUNNER_SECRET="" # Shared secret for HTTP runner (x-runner-secret header)

# Worker Process Mode:
# Set to "true" (default) to run all 6 workers inside the server process (monolith mode).
# Set to "false" if running dedicated worker processes via npm run worker:all or individual worker scripts.
START_WORKERS_IN_SERVER=true

# ==============================================================================
# External Services & APIs
# ==============================================================================
# WHOIS / RDAP lookup endpoint
RDAP_URL="https://rdap.org/domain/"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Nodemailer / SMTP (Optional)
EMAIL_USER=""
EMAIL_PASS=""

# ==============================================================================
# DEPRECATED / REMOVED:
# Redis and BullMQ are no longer used by any service in this application.
# All jobs and guest quotas are handled directly by pg-boss and PostgreSQL.
# ==============================================================================

